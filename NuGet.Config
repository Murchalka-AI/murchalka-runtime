<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="murchalka" value="https://nuget.pkg.github.com/Murchalka-AI/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="murchalka"><package pattern="Murchalka.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
